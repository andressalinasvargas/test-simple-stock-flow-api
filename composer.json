{
    "name": "adso/test-simple-stock-flow-api",
    "type": "project",
    "description": "Simple Stock Flow API - Laravel 11 Onion Architecture",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "brick/math": "^0.12.3",
        "laravel/framework": "^11.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
